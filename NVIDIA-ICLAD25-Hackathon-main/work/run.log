    .NUM_INPUTS(M),
    .DATA_WIDTH(ACC_WIDTH)
  ) u_adder_tree_decim (
    .clk      (clk),
    .arst_n   (arst_n),
    .valid_in (branches_all_valid),
    .data_in  (branch_out),
