    .o_data     (stage2_data  )
);

des_dec u_des_dec_k1 (
    .clk        (clk        ),
    .rst_async_n(rst_async_n),
    .i_start    (stage2_valid),
    .i_data     (stage2_data ),
    .i_key      (start_key_ff[129:192] ),
    .o_data     (stage3_data )
);

always_ff @(posedge clk or negedge rst_async_n) begin
    if (!rst_async_n) begin
        busy_ff        <= 1'b0;
        valid_shift_ff <= '0;
        start_data_ff  <= '0;
        start_key_ff   <= '0;
        o_done         <= 1'b1;
        o_data         <= '0;
    end else begin
        valid_shift_ff <= {valid_shift_ff[46:0], accept_start};

        if (accept_start) begin
            busy_ff <= 1'b1;
            o_done  <= 1'b0;
            start_data_ff <= i_data;
            start_key_ff  <= i_key;
        end

        if (stage3_valid) begin
            busy_ff <= 1'b0;
            o_done  <= 1'b1;
            o_data  <= stage3_data;
        end
    end
end

endmodule : des3_dec

