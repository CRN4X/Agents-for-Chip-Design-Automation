+    input  logic                i_start,
+    input  logic [NBW_DATA-1:0] i_data,
+    output logic                o_done,
+    output logic [NBW_DATA-1:0] o_data
+);
+
+localparam PKCS         = 2'b00;
+localparam ONEANDZEROES = 2'b01;
+localparam ANSIX923     = 2'b10;
+localparam W3C          = 2'b11;
