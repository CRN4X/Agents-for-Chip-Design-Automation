+module cic_decimator #(
+    parameter int WIDTH = 16,
+    parameter int RMAX = 2,
+    parameter int M = 1,
+    parameter int N = 2,
+    parameter int REG_WIDTH = WIDTH + $clog2((RMAX * M) ** N)
+) (
+    input  logic                         clk,
+    input  logic                         rst,
+    input  logic signed [WIDTH-1:0]      input_tdata,
+    input  logic                         input_tvalid,
+    output logic                         input_tready,
+    output logic signed [REG_WIDTH-1:0]  output_tdata,
+    output logic                         output_tvalid,
+    input  logic                         output_tready,
+    input  logic [$clog2(RMAX+1)-1:0]    rate
+);
+
+    localparam int RATE_WIDTH = (RMAX > 1) ? $clog2(RMAX + 1) : 1;
+
+    logic signed [REG_WIDTH-1:0] integrator_reg [0:N-1];
+    logic signed [REG_WIDTH-1:0] integrator_next[0:N-1];
+    logic signed [REG_WIDTH-1:0] comb_delay     [0:N-1][0:M-1];
+    logic signed [REG_WIDTH-1:0] comb_next      [0:N-1];
+    logic signed [REG_WIDTH-1:0] comb_input;
+
+    logic [RATE_WIDTH-1:0] effective_rate;
+    logic [RATE_WIDTH-1:0] cycle_reg;
+    logic [RATE_WIDTH-1:0] cycle_limit;
+    logic                   input_fire;
+    logic                   output_slot_open;
+    logic                   produce_output;
+
+    integer i;
+    integer j;
+
+    always_comb begin
+        if (rate == '0) begin
+            effective_rate = RATE_WIDTH'(1);
+        end else if (rate > RMAX[RATE_WIDTH-1:0]) begin
+            effective_rate = RMAX[RATE_WIDTH-1:0];
+        end else begin
+            effective_rate = rate;
+        end
+
+        cycle_limit = effective_rate - RATE_WIDTH'(1);
+        output_slot_open = !output_tvalid || output_tready;
+        input_tready = (cycle_reg != '0) || output_slot_open;
+        input_fire = input_tvalid && input_tready;
+        produce_output = input_fire && (cycle_reg == cycle_limit);
+
+        for (i = 0; i < N; i = i + 1) begin
+            integrator_next[i] = integrator_reg[i];
+        end
+
+        if (input_fire) begin
+            integrator_next[0] = integrator_reg[0] + REG_WIDTH'(input_tdata);
+            for (i = 1; i < N; i = i + 1) begin
+                integrator_next[i] = integrator_reg[i] + integrator_next[i-1];
+            end
+        end
+
+        comb_input = integrator_next[N-1];
+        for (i = 0; i < N; i = i + 1) begin
+            if (i == 0) begin
+                comb_next[i] = comb_input - comb_delay[i][M-1];
+            end else begin
+                comb_next[i] = comb_next[i-1] - comb_delay[i][M-1];
+            end
+        end
+    end
+
+    always_ff @(posedge clk) begin
+        if (rst) begin
+            cycle_reg <= '0;
+            output_tdata <= '0;
+            output_tvalid <= 1'b0;
+
+            for (i = 0; i < N; i = i + 1) begin
+                integrator_reg[i] <= '0;
+                for (j = 0; j < M; j = j + 1) begin
+                    comb_delay[i][j] <= '0;
+                end
+            end
+        end else begin
+            if (input_fire) begin
+                for (i = 0; i < N; i = i + 1) begin
+                    integrator_reg[i] <= integrator_next[i];
+                end
+
+                if (produce_output) begin
+                    cycle_reg <= '0;
+                end else begin
+                    cycle_reg <= cycle_reg + RATE_WIDTH'(1);
+                end
+            end
+
+            if (produce_output) begin
+                output_tdata <= comb_next[N-1];
+                output_tvalid <= 1'b1;
+
+                if (M > 1) begin
+                    for (i = 0; i < N; i = i + 1) begin
+                        for (j = M-1; j > 0; j = j - 1) begin
+                            if (i == 0 && j == 1) begin
+                                comb_delay[i][j] <= comb_input;
+                            end else if (i > 0 && j == 1) begin
+                                comb_delay[i][j] <= comb_next[i-1];
+                            end else begin
+                                comb_delay[i][j] <= comb_delay[i][j-1];
+                            end
+                        end
+                    end
+                end
+
+                for (i = 0; i < N; i = i + 1) begin
+                    if (i == 0) begin
+                        comb_delay[i][0] <= comb_input;
+                    end else begin
+                        comb_delay[i][0] <= comb_next[i-1];
+                    end
+                end
+            end else if (output_tvalid && output_tready) begin
+                output_tvalid <= 1'b0;
+            end
+        end
+    end
+
+endmodule

